# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is git-ignored; never commit it.

wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"

# 32 random bytes, base64-encoded, e.g.: openssl rand -base64 32
# Home Assistant asks for this key when the device is added.
# The placeholder below is a syntactically valid key (base64 of
# "REPLACE_ME_with_32_random_bytes!") so that CI can validate the config –
# it is public, NEVER use it on a real device.
api_key: "UkVQTEFDRV9NRV93aXRoXzMyX3JhbmRvbV9ieXRlcyE="

# Choose any password
ota_password: "YourOTAPassword"

# Web interface login (http://<device>/).  LAN only – see README.
web_username: "admin"
web_password: "YourWebPassword"

# Fallback access point password (WPA2, at least 8 characters).
ap_password: "YourFallbackAPPassword"
