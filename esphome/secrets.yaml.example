# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is git-ignored; never commit it.

wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"

# 32 random bytes, base64-encoded, e.g.: openssl rand -base64 32
# Home Assistant asks for this key when the device is added.
api_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Choose any password
ota_password: "YourOTAPassword"
